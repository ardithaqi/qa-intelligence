BASE_URL=https://your-app.example.com
HEADLESS=true
PW_WORKERS=2
PW_RETRIES=1

# Optional: AI failure analysis and root cause. Set one key; the provider is picked from it.
# AI_ANALYSIS=true
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-5-5   # default for anthropic
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini        # default for openai
# AI_PROVIDER=anthropic       # only needed to force one: openai | anthropic | openai-compatible
# AI_API_KEY=...              # generic fallback for any provider
# AI_BASE_URL=...             # required for openai-compatible (Ollama, Azure, etc.)
